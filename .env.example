# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# Os valores ficam em: Supabase > Project Settings > API.

# URL do projeto (ex.: https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL=

# Chave pública "anon" (NUNCA use a service_role aqui — ela vai para o navegador)
VITE_SUPABASE_KEY=
